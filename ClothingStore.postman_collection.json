{
  "info": {
    "name": "Практическая работа №3 — магазин одежды",
    "description": "Быков Денис, Седиков Артем. Запускать запросы сверху вниз. Сначала запустить API с переменными Manager__Login и Manager__Password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5167"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "managerPassword",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "sizeId",
      "value": "1"
    },
    {
      "key": "buyerId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Список одежды",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Список получен\", () => pm.response.to.have.status(200));",
              "const p = pm.response.json()[0];",
              "pm.collectionVariables.set(\"productId\", p.id);",
              "pm.collectionVariables.set(\"sizeId\", p.sizes[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Поиск по названию",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products?search=Белая",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "search",
              "value": "Белая"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Поиск работает\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Регистрация покупателя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"student_demo\",\n  \"password\": \"Student123!\",\n  \"phone\": \"+79990000000\",\n  \"address\": \"Тестовый адрес\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Пользователь создан\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"buyerId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Вход покупателя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"student_demo\",\n  \"password\": \"Student123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Вход выполнен\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"customerToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Вход менеджера",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"manager\",\n  \"password\": \"{{managerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Вход менеджера\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"managerToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Создать заказ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"sizeId\": {{sizeId}},\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Заказ создан\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Заказы по статусу",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders?status=New",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ],
          "query": [
            {
              "key": "status",
              "value": "New"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Заказы найдены\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Заказы покупателя",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders?buyerId={{buyerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ],
          "query": [
            {
              "key": "buyerId",
              "value": "{{buyerId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Заказы покупателя найдены\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Изменить статус заказа",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Processing\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}",
            "status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус изменён\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Изменить остаток размера",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}/sizes/{{sizeId}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}",
            "sizes",
            "{{sizeId}}",
            "stock"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Остаток изменён\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Убрать товар из продажи",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isForSale\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}/sale",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}",
            "sale"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Товар снят с продажи\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Вернуть товар в продажу",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isForSale\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}/sale",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}",
            "sale"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Товар возвращён в продажу\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
